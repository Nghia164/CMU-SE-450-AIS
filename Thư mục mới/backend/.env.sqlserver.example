# SQL Server connection for Laravel
APP_NAME="Smart Scheduling"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=SmartScheduling
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Laravel SQL Server options
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
